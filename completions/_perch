#compdef perch
#
# `br` and `wt` are deliberately absent here. compinit bakes this line into its
# dump, so naming them would claim both from whatever else defines them — broot
# ships its own `br` — and no runtime check can hand the name back afterwards.
# The wrapper registers them instead, under the same opt-out that creates them.

# Offers what the command will accept at the position given, under `tag`/`label`
# — asked of the binary, which answers for the position it is handed: worktree
# names after `wt rm`, and everywhere else the branches, minus the words its own
# match arm eats first. It sees remote-only branches, which the `git branch` this
# replaced could not. `command` skips the shell wrapper: it is a function here,
# and it would `cd` the interactive shell on a single-line answer.
_perch_offers() {
  local tag=$1 label=$2
  shift 2
  local -a offered
  offered=(${(f)"$(command perch "$@" --complete 2>/dev/null)"})
  # Nothing to offer leaves one empty line, which would complete to a blank.
  offered=(${offered:#})
  _describe -t "$tag" "$label" offered
}

_perch() {
  local -a subcommands branch_subs branch_rm_options worktree_subs worktree_options cmdline
  local pos
  subcommands=(
    'br:Check a branch out here'
    'wt:Worktree commands'
  )
  branch_subs=(
    'rm:Remove local branches'
  )
  branch_rm_options=(
    '--upstream:Also remove explicitly configured same-named upstreams'
    '--force:Skip destructive confirmations'
  )
  worktree_subs=(
    'ls:List worktrees'
    'rm:Remove worktree (also deletes branch)'
  )
  worktree_options=(
    '--no-switch:Create or find the worktree without switching to it'
  )
  # The wrapper asks for these two names as it defines them, but anything sourced
  # later can take one back — broot ships its own `br`. compdef records the claim
  # and would keep it, so re-read the name here, where completion actually runs
  # and the answer cannot be stale.
  if [[ "$service" != perch && "$functions[$service]" != *"perch $service \"\$@\""* ]]; then
    return 1
  fi

  # `br` and `wt` are the shell wrapper's shorthand for `perch br` and `perch wt`,
  # so every rule below reads a normalised word list with the verb spelled out.
  # One offset is all that separates the three names.
  case "$service" in
    br|wt) cmdline=(perch "$service" "${(@)words[2,-1]}"); (( pos = CURRENT + 1 )) ;;
    *)     cmdline=("${(@)words}"); pos=$CURRENT ;;
  esac

  # `br rm` is strict but takes its flags in either order around one target.
  if (( pos >= 4 )) && [[ "$cmdline[2]" == br && "$cmdline[3]" == rm ]]; then
    local word target_seen=0
    for word in "${(@)cmdline[4,pos-1]}"; do
      if [[ "$word" == -- ]]; then
        return
      elif [[ "$word" == -* ]]; then
        continue
      else
        (( target_seen = 1 ))
      fi
    done
    _describe -t options 'option' branch_rm_options
    if (( ! target_seen )); then
      _perch_offers branches 'local branch' br rm
    fi
    return
  fi

  # `wt rm` accepts one target. `--` closes option parsing, so the following
  # word counts as the target even when it begins with `-`.
  # This arm wants worktrees rather than branches, so it comes first.
  if (( pos >= 4 )) && [[ "$cmdline[2]" == wt && "$cmdline[3]" == rm ]]; then
    local word reads_options=1
    for word in "${(@)cmdline[4,pos-1]}"; do
      if (( reads_options )) && [[ "$word" == -- ]]; then
        reads_options=0
      elif (( reads_options )) && [[ "$word" == -* ]]; then
        continue
      else
        return
      fi
    done
    _perch_offers worktrees 'worktree' wt rm
    return
  fi

  if (( pos >= 3 )) && [[ "$cmdline[2]" == wt ]]; then
    local -a wt_words
    local word reads_options=1 positionals=0 has_no_switch=0
    if (( pos > 3 )); then
      wt_words=("${(@)cmdline[3,pos-1]}")
    fi
    for word in "${(@)wt_words}"; do
      if (( reads_options )) && [[ "$word" == -- ]]; then
        reads_options=0
      elif (( reads_options )) && [[ "$word" == --no-switch ]]; then
        has_no_switch=1
      elif (( reads_options && positionals == 0 )) && [[ "$word" == (ls|rm|list|remove) ]]; then
        return
      else
        (( positionals += 1 ))
      fi
    done

    if (( positionals == 0 )); then
      if (( reads_options )); then
        _describe -t subverbs 'worktree subverb' worktree_subs
      fi
      _perch_offers branches 'branch' wt "${(@)wt_words}"
    elif (( positionals == 1 )); then
      _perch_offers branches 'branch' wt "${(@)wt_words}"
    fi
    if (( reads_options && ! has_no_switch && positionals <= 2 )); then
      _describe -t options 'option' worktree_options
    fi
    return
  fi

  # `--` ends parsing, but only where the dispatcher still has a branch left to
  # read: `perch --`, `perch br --`, `perch wt --`. Past `perch wt ls`, or a
  # branch the dispatcher has already taken, the words after `--` go nowhere.
  if [[ "$cmdline[pos-1]" == -- ]]; then
    if (( pos == 3 )) ||
      { (( pos == 4 )) && [[ "$cmdline[2]" == (br|wt) ]]; } ||
      { (( pos == 5 )) && [[ "$cmdline[2]" == wt && "$cmdline[3]" == --no-switch ]]; }; then
      # The `--` is the position: it eats nothing at any of the three levels, so
      # one question answers for all of them.
      _perch_offers branches 'branch' --
    fi
  elif (( pos == 2 )); then
    _describe -t subcommands 'subcommand' subcommands
    _perch_offers branches 'branch'
  # `br` reads `rm` before a branch name.
  elif (( pos == 3 )) && [[ "$cmdline[2]" == br ]]; then
    _describe -t subverbs 'branch subverb' branch_subs
    _perch_offers branches 'branch' br
  fi
}

_perch "$@"
